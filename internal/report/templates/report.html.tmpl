{{define "dark"}}
  --bg:#241b2f; --surface:#2a2139; --surface-2:#34294f; --line:rgba(132,139,189,.26);
  --text:#f7f1ff; --muted:#848bbd; --pink:#ff7edb; --magenta:#f92aad; --cyan:#36f9f6;
  --yellow:#fede5d; --orange:#ff8b39; --green:#72f1b8; --red:#fe4450; --purple:#b893ce;
  --glow-pink:0 0 2px #100c0f,0 0 6px #dc078e,0 0 14px #fff3; --glow-green:0 0 2px #001716,0 0 10px #72f1b8;
  --glow-yellow:0 0 2px #001716,0 0 10px #f39f05; --glow-red:0 0 2px #001716,0 0 10px #fc1f2c;
  --sky:linear-gradient(180deg,#171520 0%,#2a1747 55%,#4b1d52 100%);
  --sun:linear-gradient(180deg,#fede5d 0%,#ff8b39 45%,#f92aad 100%); --grid:#f92aad;
{{end}}{{define "light"}}
  --bg:#fdf8ff; --surface:#ffffff; --surface-2:#f4ecfd; --line:rgba(73,84,149,.2);
  --text:#241b2f; --muted:#5d5687; --pink:#b8127c; --magenta:#c4007a; --cyan:#00767f;
  --yellow:#8a6100; --orange:#a84a00; --green:#047a4f; --red:#cc1c33; --purple:#6d3fa0;
  --glow-pink:none; --glow-green:none; --glow-yellow:none; --glow-red:none;
  --sky:linear-gradient(180deg,#ffe9f6 0%,#ffd6e8 55%,#ffc2d6 100%);
  --sun:linear-gradient(180deg,#ffb347 0%,#ff7a59 45%,#e0357f 100%); --grid:#d6246e;
{{end}}<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="color-scheme" content="light dark">
<title>lemmings report — {{.Config.Hit}}</title>
<style>
:root { {{template "light"}} --radius:10px; --mono:ui-monospace,SFMono-Regular,Menlo,Consolas,monospace; }
@media (prefers-color-scheme: dark) { :root:not(:has(#flip:checked)) { {{template "dark"}} } }
@media (prefers-color-scheme: light) { :root:has(#flip:checked) { {{template "dark"}} } }
*,*::before,*::after { box-sizing:border-box; margin:0; padding:0; }
body { background:var(--bg); color:var(--text); font:15px/1.55 -apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,sans-serif; }
main { max-width:1160px; margin:0 auto; padding:0 20px 48px; }
a { color:var(--cyan); }
code,.mono { font-family:var(--mono); font-size:.9em; }
.muted { color:var(--muted); }
.flip { position:absolute; opacity:0; pointer-events:none; }
.flip-label { position:absolute; top:14px; right:16px; z-index:2; cursor:pointer; font-size:12px; letter-spacing:.08em;
  text-transform:uppercase; color:#fff; background:rgba(0,0,0,.25); border:1px solid rgba(255,255,255,.35); border-radius:999px; padding:5px 12px; }
.flip:focus-visible + .flip-label { outline:2px solid var(--cyan); outline-offset:2px; }

.hero { position:relative; overflow:hidden; background:var(--sky); padding:56px 20px 0; text-align:center; min-height:300px; }
.sun { position:absolute; left:50%; top:78px; width:240px; height:240px; margin-left:-120px; border-radius:50%; background:var(--sun);
  -webkit-mask:linear-gradient(180deg,#000 0 52%,transparent 52% 56%,#000 56% 64%,transparent 64% 69%,#000 69% 76%,transparent 76% 82%,#000 82% 87%,transparent 87% 93%,#000 93% 96%,transparent 96%); mask:linear-gradient(180deg,#000 0 52%,transparent 52% 56%,#000 56% 64%,transparent 64% 69%,#000 69% 76%,transparent 76% 82%,#000 82% 87%,transparent 87% 93%,#000 93% 96%,transparent 96%); opacity:.9; }
.floor { position:absolute; left:-60%; right:-60%; bottom:0; height:170px; transform:perspective(320px) rotateX(62deg); transform-origin:bottom;
  background-image:linear-gradient(var(--grid) 2px,transparent 2px),linear-gradient(90deg,var(--grid) 2px,transparent 2px); background-size:64px 32px; opacity:.6;
  -webkit-mask:linear-gradient(transparent,#000 40%); mask:linear-gradient(transparent,#000 40%); animation:drive 1.6s linear infinite; }
@keyframes drive { to { background-position:0 32px; } }
.hero h1 { position:relative; font-size:clamp(40px,8vw,78px); letter-spacing:.12em; font-weight:800; color:#fff;
  text-shadow:var(--glow-pink); font-style:italic; }
.hero .sub { position:relative; color:#fff; opacity:.92; margin-top:4px; font-size:14px; }
.hero .sub a { color:#fff; }
.hero-pad { height:150px; }

.verdict { margin:-40px auto 24px; position:relative; background:var(--surface); border:1px solid var(--line); border-radius:16px;
  padding:24px 28px; display:grid; grid-template-columns:auto 1fr; gap:8px 28px; align-items:center; box-shadow:0 18px 50px rgba(20,10,40,.25); }
.verdict .score { font-size:64px; font-weight:800; line-height:1; color:var(--green); text-shadow:var(--glow-green); font-variant-numeric:tabular-nums; }
.verdict.warn .score { color:var(--yellow); text-shadow:var(--glow-yellow); } .verdict.bad .score { color:var(--red); text-shadow:var(--glow-red); }
.verdict .score small { display:block; font-size:12px; letter-spacing:.2em; text-transform:uppercase; color:var(--muted); text-shadow:none; margin-top:6px; }
.verdict h2 { font-size:22px; } .verdict p { color:var(--muted); }
.gates { grid-column:1 / -1; display:flex; flex-wrap:wrap; gap:8px; margin-top:8px; }
.gate { border:1px solid var(--line); border-radius:999px; padding:4px 12px; font-size:13px; }
.gate.pass { color:var(--green); border-color:var(--green); } .gate.fail { color:var(--red); border-color:var(--red); font-weight:700; }
.integrity-banner { margin:0 auto 20px; background:rgba(254,68,80,.10); border:2px solid var(--red); border-radius:var(--radius); padding:14px 18px; }
.integrity-banner strong.banner-title { color:var(--red); display:block; font-size:13px; letter-spacing:.08em; text-transform:uppercase; margin-bottom:4px; }
.integrity-banner ul { margin:6px 0 0 18px; font-size:14px; }

.kpis { display:grid; grid-template-columns:repeat(4,1fr); gap:12px; margin-bottom:28px; }
@media (max-width:760px) { .kpis { grid-template-columns:repeat(2,1fr); } }
.kpi { background:var(--surface); border:1px solid var(--line); border-radius:var(--radius); padding:14px 16px; }
.kpi span { display:block; font-size:11px; letter-spacing:.12em; text-transform:uppercase; color:var(--muted); }
.kpi strong { display:block; font-size:24px; margin-top:4px; font-variant-numeric:tabular-nums; }
.kpi em { font-style:normal; font-size:12px; color:var(--muted); }
h2.section { font-size:13px; letter-spacing:.2em; text-transform:uppercase; color:var(--pink); margin:34px 0 12px; }
.card { background:var(--surface); border:1px solid var(--line); border-radius:var(--radius); padding:18px; }
.grid-2 { display:grid; grid-template-columns:repeat(auto-fit,minmax(320px,1fr)); gap:16px; }
.scroll { overflow-x:auto; }
table { width:100%; border-collapse:collapse; font-size:14px; font-variant-numeric:tabular-nums; }
th { text-align:left; font-size:11px; letter-spacing:.1em; text-transform:uppercase; color:var(--muted); font-weight:600; padding:8px 10px; border-bottom:1px solid var(--line); }
td { padding:7px 10px; border-bottom:1px solid var(--line); vertical-align:top; }
tr:last-child td { border-bottom:none; }
td.num,th.num { text-align:right; white-space:nowrap; }
td.url { font-family:var(--mono); font-size:13px; overflow-wrap:anywhere; }
.bar { height:6px; border-radius:3px; background:var(--pink); opacity:.8; min-width:2px; }
.chip { display:inline-block; font-family:var(--mono); font-size:12px; font-weight:700; padding:1px 7px; border-radius:6px; border:1px solid currentColor; }
.c2xx { color:var(--green); } .c3xx { color:var(--cyan); } .c4xx { color:var(--yellow); } .c5xx { color:var(--red); } .cunknown { color:var(--purple); }
.m-get,.m-head,.m-options { color:var(--cyan); } .m-post { color:var(--pink); } .m-put,.m-patch { color:var(--yellow); } .m-delete { color:var(--red); }
.fail-text { color:var(--red); } .warn-text { color:var(--yellow); } .pass-text { color:var(--green); }
.persona-card { margin-bottom:16px; }
.persona-card:last-child { margin-bottom:0; }
.persona-head { display:flex; flex-wrap:wrap; align-items:baseline; gap:8px 14px; margin-bottom:12px; }
.persona-head h3 { font-size:17px; }
.persona-head .meta { color:var(--muted); font-size:13px; }
tr.failed td { background:rgba(254,68,80,.07); }

.chart { width:100%; height:auto; display:block; margin:6px 0 18px; }
.chart .grid { stroke:var(--line); stroke-width:1; }
.chart .axis,.chart .unit { fill:var(--muted); font-size:12px; font-family:var(--mono); }
.chart .line { fill:none; stroke-width:2.2; stroke-linejoin:round; vector-effect:non-scaling-stroke; }
.chart .dash { stroke-dasharray:6 5; }
.chart .area { stroke:none; opacity:.18; }
.s-rate { stroke:var(--cyan); fill:var(--cyan); } .s-fail { fill:var(--red); opacity:.85; }
.s-alive { stroke:var(--yellow); } .s-queued { stroke:var(--orange); } .s-p95 { stroke:var(--pink); } .s-p50 { stroke:var(--cyan); }
.legend { display:flex; flex-wrap:wrap; gap:16px; font-size:13px; color:var(--muted); }
.legend i { display:inline-block; width:18px; height:3px; border-radius:2px; vertical-align:middle; margin-right:6px; }

.lives { display:grid; gap:16px; }
.life summary { display:flex; flex-wrap:wrap; gap:6px 14px; align-items:baseline; cursor:pointer; list-style:none; }
.life summary::-webkit-details-marker { display:none; }
.life summary::after { content:"＋"; margin-left:auto; color:var(--muted); } .life[open] summary::after { content:"－"; }
.life[open] summary { margin-bottom:14px; }
.steps .page-title { font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,sans-serif; font-size:13px; }
.life h3 { font-size:18px; } .life h3 span { color:var(--pink); }
.life .tag { font-size:11px; letter-spacing:.14em; text-transform:uppercase; color:var(--cyan); }
.life .meta { color:var(--muted); font-size:13px; }
.steps td { padding:5px 8px; }
.steps td.bar-cell { width:30%; }
.steps .why { color:var(--red); font-size:12px; }

/* ── error forensics & screenshots ──────────────────────────────────────── */
.pill { display:inline-block; font-size:11px; font-weight:700; letter-spacing:.1em; text-transform:uppercase; padding:2px 8px; border-radius:999px; border:1px solid currentColor; }
.rev-unreviewed { color:var(--muted); } .rev-bug { color:var(--red); } .rev-flaky { color:var(--yellow); } .rev-expected { color:var(--cyan); } .rev-ignored { color:var(--purple); }
.forensic-grid { display:grid; grid-template-columns:minmax(280px,1.1fr) 1fr; gap:16px; margin-top:10px; }
@media (max-width:860px) { .forensic-grid { grid-template-columns:1fr; } }
.shot-box { background:var(--surface-2); border:1px solid var(--line); border-radius:8px; padding:10px; }
.shot-box img { display:block; width:100%; height:auto; border-radius:6px; border:1px solid var(--line); }
.shot-meta { font-size:11px; color:var(--muted); margin-top:6px; font-family:var(--mono); }
.excerpt { background:var(--surface-2); border:1px solid var(--line); border-radius:8px; padding:10px 12px; font:12px/1.45 var(--mono); white-space:pre-wrap; overflow-wrap:anywhere; max-height:240px; overflow:auto; margin-top:8px; }
.review-note { background:var(--surface-2); border-left:3px solid var(--pink); padding:8px 12px; border-radius:6px; margin:8px 0 12px; font-size:13px; }
.lvl-error,.lvl-exception { color:var(--red); font-weight:700; } .lvl-warning,.lvl-network { color:var(--yellow); font-weight:700; }
.subhead { font-size:11px; letter-spacing:.16em; text-transform:uppercase; color:var(--cyan); margin:14px 0 6px; }
footer { color:var(--muted); font-size:13px; text-align:center; margin-top:40px; }

@media (max-width:640px) { .verdict { grid-template-columns:1fr; text-align:center; } .gates { justify-content:center; } .hero-pad { height:130px; } }
@media (prefers-reduced-motion: reduce) { .floor { animation:none; } }
@media print { .floor { animation:none; } .flip-label { display:none; } }
</style>
</head>
<body>
<input type="checkbox" id="flip" class="flip" aria-label="Switch light or dark theme">
<label for="flip" class="flip-label">◐ theme</label>

<header class="hero">
  <div class="sun" aria-hidden="true"></div>
  <div class="floor" aria-hidden="true"></div>
  <h1>LEMMINGS</h1>
  <p class="sub">
    <a href="{{.Config.Hit}}">{{.Config.Hit}}</a> · {{.GeneratedAt.Format "2006-01-02 15:04 MST"}} · {{round .Duration}}{{if .Plan}} · plan <strong>{{with planNames .Plan}}{{.}}{{else}}enabled{{end}}</strong>{{end}}
  </p>
  <div class="hero-pad"></div>
</header>

<main>
<section class="verdict{{if lt .RescuedPercent 50.0}} bad{{else if lt .RescuedPercent 99.95}} warn{{end}}">
  <div class="score">{{pct100 .RescuedPercent}}<small>rescued</small></div>
  <div>
    <h2>{{rescueLine .Data}}</h2>
    <p>{{formatInt .Rescued}} of {{formatInt .Sessions}} lemmings lived their whole life without a single failed page.
    {{if .Gates}}Verdict: <strong{{if eq .Verdict "FAILED"}} class="fail-text"{{end}}>{{.Verdict}}</strong>.{{else}}No CI gates were set.{{end}}</p>
  </div>
  {{if .Gates}}<div class="gates">{{range .Gates}}<span class="gate {{if .Passed}}pass{{else}}fail{{end}}">{{if .Passed}}✓{{else}}✗{{end}} {{.Name}} {{.Observed}} (limit {{.Limit}})</span>{{end}}</div>{{end}}
</section>

{{if or .DroppedLogs .TraceDropped .Forensics.Stats.DroppedQueue}}
<section class="integrity-banner" role="alert">
  <strong class="banner-title">⚠ Data Integrity Warning — Telemetry Drops Detected</strong>
  <p>One or more collector queues overflowed during this run; affected telemetry may be incomplete:</p>
  <ul>
    {{if .DroppedLogs}}<li><strong>{{formatInt .DroppedLogs}}</strong> lemming life records dropped under collector pressure</li>{{end}}
    {{if .TraceDropped}}<li><strong>{{formatInt .TraceDropped}}</strong> trace records dropped (trace writer queue full)</li>{{end}}
    {{if .Forensics.Stats.DroppedQueue}}<li><strong>{{formatInt .Forensics.Stats.DroppedQueue}}</strong> error forensics captures dropped (forensics queue full)</li>{{end}}
  </ul>
</section>
{{end}}

<section class="kpis">
  <div class="kpi"><span>page visits</span><strong>{{formatInt .TotalVisits}}</strong><em>{{float1 .VisitsPerSecond}} / s</em></div>
  <div class="kpi"><span>failed</span><strong{{if .FailedVisits}} class="fail-text"{{end}}>{{pct .FailureRate}}</strong><em>{{formatInt .FailedVisits}} visits</em></div>
  <div class="kpi"><span>p50</span><strong>{{ms .P50}}</strong><em>mean {{ms .Mean}}</em></div>
  <div class="kpi"><span>p95</span><strong>{{ms .P95}}</strong><em>ttfb {{ms .TTFBP95}}</em></div>
  <div class="kpi"><span>p99</span><strong>{{ms .P99}}</strong><em>max {{ms .Slowest}}</em></div>
  <div class="kpi"><span>lemmings</span><strong>{{formatInt .LemmingsStarted}}</strong><em>{{formatInt .LemmingsCompleted}} completed · {{formatInt .LemmingsUnborn}} unborn / {{formatInt .TotalLemmings}}</em></div>
  <div class="kpi"><span>transferred</span><strong>{{.TotalBytes | formatBytesInt}}</strong><em>decoded page bodies</em></div>
  <div class="kpi"><span>error artifacts</span><strong{{if .Forensics.Stats.Captured}} class="warn-text"{{end}}>{{formatInt .Forensics.Stats.Captured}}</strong><em>{{formatInt .Forensics.Stats.WithScreenshots}} screenshots</em></div>
</section>

{{if .Plan}}
<h2 class="section">Plan execution</h2>
<section class="kpis">
  <div class="kpi"><span>plan pass rate</span><strong class="{{if lt .Plan.PlanPassRate 50.0}}fail-text{{else if lt .Plan.PlanPassRate 99.95}}warn-text{{else}}pass-text{{end}}">{{pct100 .Plan.PlanPassRate}}</strong><em>{{formatInt .Plan.PlanPassed}} passed · {{formatInt .Plan.PlanFailed}} failed</em></div>
  <div class="kpi"><span>plan lemmings</span><strong>{{formatInt .Plan.PlanLemmings}}</strong><em>{{len .Plan.Personas}} persona{{if ne (len .Plan.Personas) 1}}s{{end}}</em></div>
  <div class="kpi"><span>rogue lemmings</span><strong>{{formatInt .Plan.RogueLemmings}}</strong><em>{{formatInt .Plan.RogueFlawless}} flawless</em></div>
  <div class="kpi"><span>rogue rate</span><strong>{{pct .Plan.RogueRate}}</strong><em>configured cohort split</em></div>
</section>
{{range .Plan.Personas}}
<div class="card persona-card">
  <div class="persona-head">
    <span class="pill {{if and .Lemmings (eq .Failed 0)}}c2xx{{else if .Failed}}c5xx{{else}}rev-unreviewed{{end}}">weight {{.Weight}}</span>
    <h3>{{.Name}}</h3>
    <span class="meta">{{formatInt .Passed}} / {{formatInt .Lemmings}} passed ({{pct100 .PassRate}}) · {{.TotalSteps}} step{{if ne .TotalSteps 1}}s{{end}}</span>
  </div>
  {{if .Steps}}
  <div class="scroll"><table>
    <tr><th class="num">#</th><th>step</th><th>method</th><th>path</th><th class="num">hits</th><th class="num">passed</th><th class="num">failed</th><th class="num">p50</th><th class="num">p95</th><th class="num">p99</th><th>top failure</th></tr>
    {{range .Steps}}<tr{{if .Failed}} class="failed"{{end}}>
      <td class="num muted">{{.Index}}</td>
      <td><strong>{{.Name}}</strong></td>
      <td><span class="chip m-{{methodClass .Method}}">{{.Method}}</span></td>
      <td class="url">{{.Path}}</td>
      <td class="num">{{formatInt .Hits}}</td>
      <td class="num c2xx">{{formatInt .Passed}}</td>
      <td class="num{{if .Failed}} fail-text{{end}}">{{formatInt .Failed}}</td>
      <td class="num">{{if .Hits}}{{ms .P50}}{{else}}<span class="muted">—</span>{{end}}</td>
      <td class="num">{{if .Hits}}{{ms .P95}}{{else}}<span class="muted">—</span>{{end}}</td>
      <td class="num">{{if .Hits}}{{ms .P99}}{{else}}<span class="muted">—</span>{{end}}</td>
      <td>{{if .TopFailure}}<span class="fail-text">{{.TopFailure}}</span>{{else}}<span class="muted">—</span>{{end}}</td>
    </tr>{{end}}
  </table></div>
  {{end}}
</div>
{{end}}
{{end}}

<h2 class="section">The run</h2>
<div class="card">
  <div class="legend">
    <span><i style="background:var(--cyan)"></i>visits / s</span>
    <span><i style="background:var(--red)"></i>failures / s</span>
    <span><i style="background:var(--yellow)"></i>lemmings alive</span>
    {{if or .Room.Held .Room.TotalPolls}}<span><i style="background:var(--orange)"></i>queued</span>{{end}}
    <span><i style="background:var(--pink)"></i>p95 latency</span>
    <span><i style="background:var(--cyan)"></i>p50 latency</span>
  </div>
  {{timelineSVG .Timeline}}
</div>

<div class="grid-2">
  <div>
    <h2 class="section">Response codes</h2>
    <div class="card"><table>
      <tr><th>status</th><th class="num">count</th><th></th></tr>
      {{range .StatusCodes}}<tr><td><span class="chip c{{statusClass (atoi .Label)}}">{{.Label}}</span></td><td class="num">{{formatInt .Count}}</td><td style="width:45%"><div class="bar" style="width:{{width .Share}}"></div></td></tr>
      {{else}}<tr><td colspan="3" class="muted">No visits were recorded.</td></tr>{{end}}
    </table></div>
  </div>
  <div>
    <h2 class="section">What went wrong</h2>
    <div class="card">
      {{if or .ErrorKinds .FailedChecks}}<table>
        <tr><th>cause</th><th class="num">count</th></tr>
        {{range .ErrorKinds}}<tr><td>error: <code>{{.Label}}</code></td><td class="num">{{formatInt .Count}}</td></tr>{{end}}
        {{range .FailedChecks}}<tr><td>check: <code>{{.Label}}</code></td><td class="num">{{formatInt .Count}}</td></tr>{{end}}
      </table>{{else}}<p class="muted">Nothing. Every completed visit passed every check.</p>{{end}}
      {{if .CancelledVisits}}<p class="muted" style="margin-top:10px">{{formatInt .CancelledVisits}} visits were cut short when a lemming's life ended; they are not counted as failures or in latency.</p>{{end}}
    </div>
  </div>
</div>

{{if .Forensics.Artifacts}}
<h2 class="section">Error forensics &amp; screenshots ({{formatInt .Forensics.Stats.Captured}} captured · {{formatInt .Forensics.Stats.Bug}} bugs · {{formatInt .Forensics.Stats.Flaky}} flaky · {{formatInt .Forensics.Stats.Unreviewed}} unreviewed)</h2>
<div class="lives">
{{range $i, $a := .Forensics.Artifacts}}
  <details class="card life"{{if lt $i 3}} open{{end}}>
    <summary>
      <span class="pill rev-{{$a.ReviewStatus}}">{{$a.ReviewStatus}}</span>
      {{if $a.Session.Method}}<span class="chip m-{{methodClass $a.Session.Method}}">{{$a.Session.Method}}</span>{{end}}
      <span class="chip c{{statusClass $a.StatusCode}}">{{if $a.StatusCode}}{{$a.StatusCode}}{{else}}ERR{{end}}</span>
      <h3>{{$a.Path}} <span class="mono">Lemming #{{$a.Session.LemmingNumber}} · {{$a.Session.LemmingName}}</span></h3>
      <span class="meta">{{$a.TriggerReason}} · {{$a.CaptureMode}} · {{$a.ErrorBody.Summary}}{{if $a.ConsoleErrors}} · <span class="fail-text">{{$a.ConsoleErrors}} JS errors</span>{{end}}</span>
    </summary>

    {{if $a.ReviewNote}}<div class="review-note"><strong>Admin triage note:</strong> {{$a.ReviewNote}}</div>{{end}}
    {{if $a.CaptureWarning}}<p class="muted">Capture note: {{$a.CaptureWarning}}</p>{{end}}

    <div class="forensic-grid">
      <div>
        <div class="subhead">Visual screenshot</div>
        {{$uri := index $.InlineImages $a.ID}}
        {{if $uri}}
          <div class="shot-box">
            <img src="{{$uri}}" alt="Screenshot of {{$a.Path}} for Lemming #{{$a.Session.LemmingNumber}}">
            <div class="shot-meta">{{$a.Screenshot.Width}}×{{$a.Screenshot.Height}} · {{$a.Screenshot.MIMEType}} · {{formatBytesInt (add $a.Screenshot.Bytes 0)}} · sha256:{{shortID $a.Screenshot.SHA256}}</div>
          </div>
        {{else if $a.Screenshot}}
          {{if $.OmitScreenshots}}
          <div class="shot-box"><p class="muted">Screenshot omitted from remote report (screenshots are not scrubbed; pass <code>-include-remote-screenshots</code> to opt in, or view in local report / Admin Portal).</p></div>
          {{else}}
          <div class="shot-box"><p class="muted">Screenshot saved externally at <code>{{$a.Screenshot.RelativePath}}</code> (omitted inline to respect HTML size budget).</p></div>
          {{end}}
        {{else}}
          <div class="shot-box"><p class="muted">No screenshot captured ({{$a.CaptureMode}}).</p></div>
        {{end}}

        <div class="subhead">Extracted error page body ({{$a.ErrorBody.Format}})</div>
        <table>
          <tr><td>summary</td><td><strong>{{$a.ErrorBody.Summary}}</strong></td></tr>
          {{if $a.ErrorBody.Title}}<tr><td>title</td><td>{{$a.ErrorBody.Title}}</td></tr>{{end}}
          {{if $a.ErrorBody.ErrorCode}}<tr><td>error code</td><td><code>{{$a.ErrorBody.ErrorCode}}</code></td></tr>{{end}}
          {{if $a.ErrorBody.RequestID}}<tr><td>request id</td><td><code>{{$a.ErrorBody.RequestID}}</code></td></tr>{{end}}
          <tr><td>body size</td><td>{{formatBytesInt $a.ErrorBody.BodyBytes}}</td></tr>
        </table>
        {{if $a.ErrorBody.StackTrace}}<pre class="excerpt">{{$a.ErrorBody.StackTrace}}</pre>{{end}}
        {{if $a.ErrorBody.BodyExcerpt}}<pre class="excerpt">{{$a.ErrorBody.BodyExcerpt}}</pre>{{end}}
      </div>

      <div>
        <div class="subhead">Session state &amp; lemming identity</div>
        <table>
          <tr><td>lemming</td><td><strong>#{{$a.Session.LemmingNumber}}</strong> · {{$a.Session.LemmingName}} (<code>{{shortID $a.Session.LemmingID}}</code>)</td></tr>
          <tr><td>location</td><td>terrain {{$a.Session.Terrain}}, pack {{$a.Session.Pack}} · source: {{$a.Session.Source}}</td></tr>
          <tr><td>persona</td><td>{{$a.Session.Persona}} · {{lang $a.Session.Language}}</td></tr>
          {{if $a.Session.Role}}<tr><td>role</td><td><span class="pill c3xx">{{$a.Session.Role}}</span>{{if $a.Session.PlanName}} · plan <strong>{{$a.Session.PlanName}}</strong>{{end}}</td></tr>{{end}}
          <tr><td>navigation</td><td>{{$a.Session.NavigationMode}}{{if $a.Session.Method}} · <span class="chip m-{{methodClass $a.Session.Method}}">{{$a.Session.Method}}</span>{{end}}{{if and (not $a.Session.Role) $a.Session.PlanName}} · plan "{{$a.Session.PlanName}}"{{end}}{{if $a.Session.PlanStep}} · step "{{$a.Session.PlanStep}}"{{end}} · visit #{{$a.Session.VisitSequence}}</td></tr>
          {{if $a.Session.RecentTrail}}<tr><td>recent trail</td><td class="mono">{{join $a.Session.RecentTrail " → "}}</td></tr>{{end}}
        </table>

        <div class="subhead">Cookie jar status ({{$a.Session.CookieJar.Health}} · {{$a.Session.CookieJar.ActiveCookies}} active, {{$a.Session.CookieJar.ExpiredCookies}} expired)</div>
        {{if $a.Session.CookieJar.Cookies}}
        <div class="scroll"><table>
          <tr><th>name</th><th>scope</th><th>flags</th><th>state</th><th class="num">size</th></tr>
          {{range $a.Session.CookieJar.Cookies}}<tr>
            <td><code>{{.Name}}</code><br><span class="muted mono">fp:{{.Fingerprint}}</span></td>
            <td class="mono">{{.Domain}}{{.Path}}</td>
            <td>{{if .Secure}}Secure {{end}}{{if .HTTPOnly}}HttpOnly {{end}}{{if .SameSite}}SameSite={{.SameSite}}{{end}}</td>
            <td>{{if .Expired}}<span class="fail-text">expired</span>{{else if .SessionOnly}}session{{else}}active{{end}}</td>
            <td class="num">{{.ValueBytes}} B</td>
          </tr>{{end}}
        </table></div>
        {{else}}<p class="muted">Cookie jar was empty at the time of failure.</p>{{end}}

        <div class="subhead">JavaScript console output ({{len $a.Console}} entries)</div>
        {{if $a.Console}}
        <div class="scroll"><table>
          <tr><th>level</th><th>message</th></tr>
          {{range $a.Console}}<tr>
            <td class="lvl-{{.Level}}">{{upper .Level}}</td>
            <td><code>{{.Text}}</code>{{if .SourceURL}}<br><span class="muted mono">{{.SourceURL}}{{if .Line}}:{{.Line}}{{end}}</span>{{end}}{{if .StackTrace}}<pre class="excerpt">{{.StackTrace}}</pre>{{end}}</td>
          </tr>{{end}}
        </table></div>
        {{else}}<p class="muted">No console output recorded.</p>{{end}}
      </div>
    </div>
  </details>
{{end}}
</div>
{{end}}

{{if or .Assets.Requests .Config.Assets}}
<h2 class="section">Same-origin assets (separated from page latency)</h2>
<section class="kpis">
  <div class="kpi"><span>asset requests</span><strong>{{formatInt .Assets.Requests}}</strong><em>{{.Assets.Bytes | formatBytesInt}}</em></div>
  <div class="kpi"><span>asset failed</span><strong{{if .Assets.Failed}} class="fail-text"{{end}}>{{formatInt .Assets.Failed}}</strong><em>subresource errors</em></div>
  <div class="kpi"><span>asset 403 denied</span><strong{{if .Assets.Denied403}} class="fail-text"{{end}}>{{formatInt .Assets.Denied403}}</strong><em>admit pass denied</em></div>
  <div class="kpi"><span>asset p95</span><strong>{{ms .Assets.P95}}</strong><em>p50 {{ms .Assets.P50}} · p99 {{ms .Assets.P99}}</em></div>
</section>
{{if .Assets.ByClass}}
<div class="card scroll"><table>
  <tr><th>class</th><th class="num">requests</th><th class="num">failed</th><th class="num">403 denied</th><th class="num">p95</th><th class="num">bytes</th></tr>
  {{range .Assets.ByClass}}<tr>
    <td><span class="chip c3xx">{{.Class}}</span></td>
    <td class="num">{{formatInt .Requests}}</td>
    <td class="num{{if .Failed}} fail-text{{end}}">{{formatInt .Failed}}</td>
    <td class="num{{if .Denied403}} fail-text{{end}}">{{formatInt .Denied403}}</td>
    <td class="num">{{ms .P95}}</td>
    <td class="num muted">{{.Bytes | formatBytesInt}}</td>
  </tr>{{end}}
</table></div>
{{end}}
{{end}}

{{if or .Room.Held .Room.Rejected503 .Room.TotalPolls}}
<h2 class="section">Waiting room</h2>
<section class="kpis">
  <div class="kpi"><span>held</span><strong>{{formatInt .Room.Held}}</strong><em>visits queued</em></div>
  <div class="kpi"><span>admitted</span><strong>{{formatInt .Room.Admitted}}</strong><em>passed into origin</em></div>
  <div class="kpi"><span>died in line</span><strong{{if .Room.DiedInLine}} class="fail-text"{{end}}>{{formatInt .Room.DiedInLine}}</strong><em>cancelled / error</em></div>
  <div class="kpi"><span>expired / denied</span><strong{{if or .Room.Expired .Room.Denied}} class="fail-text"{{end}}>{{formatInt .Room.Expired}} / {{formatInt .Room.Denied}}</strong><em>evicted · 403 denied</em></div>
  <div class="kpi"><span>rejected 503</span><strong{{if .Room.Rejected503}} class="fail-text"{{end}}>{{formatInt .Room.Rejected503}}</strong><em>breaker / capacity</em></div>
  <div class="kpi"><span>queue polls</span><strong>{{formatInt .Room.TotalPolls}}</strong><em>status checks</em></div>
  <div class="kpi"><span>deepest</span><strong>#{{.Room.MaxPosition}}</strong><em>queue position</em></div>
  <div class="kpi"><span>wait time</span><strong>{{round .Room.MeanWait}}</strong><em>p95 {{round .Room.P95Wait}} · max {{round .Room.LongestWait}}</em></div>
</section>
{{end}}

{{if or .Concert.AdmitPasses .Concert.RoomTickets .Concert.Bans429 .Concert.Bans403}}
<h2 class="section">Concert passes &amp; bans</h2>
<section class="kpis">
  <div class="kpi"><span>admit passes</span><strong>{{formatInt .Concert.AdmitPasses}}</strong><em>visits with concert_admit</em></div>
  <div class="kpi"><span>room tickets</span><strong>{{formatInt .Concert.RoomTickets}}</strong><em>visits with room_ticket</em></div>
  <div class="kpi"><span>bans (429)</span><strong{{if .Concert.Bans429}} class="fail-text"{{end}}>{{formatInt .Concert.Bans429}}</strong><em>rate-limit bans</em></div>
  <div class="kpi"><span>bans (403)</span><strong{{if .Concert.Bans403}} class="fail-text"{{end}}>{{formatInt .Concert.Bans403}}</strong><em>forbidden bans</em></div>
</section>
{{end}}

{{if or .Scouts.Visits .Config.Scouts}}
<h2 class="section">Browser scouts</h2>
<section class="kpis">
  <div class="kpi"><span>scouts configured</span><strong>{{.Config.Scouts}}</strong><em>real Chrome sessions</em></div>
  <div class="kpi"><span>scout visits</span><strong>{{formatInt .Scouts.Visits}}</strong><em>page navigations</em></div>
  <div class="kpi"><span>scout failures</span><strong{{if .Scouts.Failures}} class="fail-text"{{end}}>{{formatInt .Scouts.Failures}}</strong><em>failed navigations</em></div>
</section>
{{end}}

{{if .Notable}}
<h2 class="section">Lemmings worth meeting</h2>
<div class="lives">
{{range $i, $l := .Notable}}{{with $l}}
  <details class="card life"{{if eq $i 0}} open{{end}}>
    <summary>
      <span class="tag">{{.Title}}</span>
      {{if .Role}}<span class="pill {{if eq .Role "plan"}}{{if .PlanPassed}}c2xx{{else}}c5xx{{end}}{{else}}c3xx{{end}}">{{.Role}}{{if .PlanName}}: {{.PlanName}}{{end}}</span>{{end}}
      <h3>#{{.Number}} {{.Name}} <span class="mono">{{shortID .ID}}</span></h3>
      <span class="meta">{{.Why}} · {{.Persona}} · {{lang .Language}} · terrain {{.Terrain}}, pack {{.Pack}}{{if .PlanName}} · plan {{.PlanName}} ({{if .PlanPassed}}passed{{else}}failed{{end}}){{end}} · lived {{round .Lifespan}} · {{formatInt .Visits}} pages{{if .Failed}}, <span class="fail-text">{{formatInt .Failed}} failed</span>{{end}} · left: {{.ExitReason}}</span>
    </summary>
    <div class="scroll"><table class="steps">
      {{range .Steps}}<tr{{if .Failed}} class="failed"{{end}}>
        <td class="num muted">{{.Seq}}</td>
        <td><span class="chip m-{{methodClass .Method}}">{{if .Method}}{{.Method}}{{else}}GET{{end}}</span></td>
        <td class="url">{{if .Step}}<strong>{{.Step}}</strong> {{end}}{{.Path}}{{if .Title}}<br><span class="muted page-title">{{.Title}}</span>{{end}}{{if .Why}}<br><span class="why">{{.Why}}</span>{{end}}</td>
        <td>{{if .Status}}<span class="chip c{{statusClass .Status}}">{{.Status}}</span>{{else}}<span class="chip cunknown">—</span>{{end}}</td>
        <td class="bar-cell"><div class="bar" style="width:{{width .Bar}};{{if .Failed}}background:var(--red){{end}}"></div></td>
        <td class="num">{{float1 .Millis}} ms{{if .QueuedMS}}<br><span class="muted">queued {{float1 .QueuedMS}} ms</span>{{end}}</td>
      </tr>{{end}}
    </table></div>
    {{if .Omitted}}<p class="muted" style="margin-top:8px">{{formatInt .Omitted}} earlier pages not shown.</p>{{end}}
  </details>
{{end}}{{end}}
</div>
{{end}}

<h2 class="section">Per-path breakdown</h2>
<div class="card scroll"><table>
  <tr><th>path</th><th class="num">hits</th><th></th><th class="num">p50</th><th class="num">p95</th><th class="num">p99</th><th class="num">2xx</th><th class="num">3xx</th><th class="num">4xx</th><th class="num">5xx</th><th class="num">failed</th><th class="num">bytes</th></tr>
  {{range .Paths}}<tr>
    <td class="url">{{.URL}}</td><td class="num">{{formatInt .Hits}}</td><td style="width:90px"><div class="bar" style="width:{{width .HitShare}}"></div></td>
    <td class="num">{{ms .P50}}</td><td class="num">{{ms .P95}}</td><td class="num">{{ms .P99}}</td>
    <td class="num c2xx">{{formatInt .XX2}}</td><td class="num c3xx">{{formatInt .XX3}}</td><td class="num c4xx">{{formatInt .XX4}}</td><td class="num c5xx">{{formatInt .XX5}}</td>
    <td class="num{{if .Failed}} fail-text{{end}}">{{formatInt .Failed}}</td><td class="num muted">{{.Bytes}}</td>
  </tr>{{end}}
</table></div>

<div class="grid-2">
  <div>
    <h2 class="section">Configuration</h2>
    <div class="card"><table>
      <tr><td>terrain × pack</td><td class="num">{{formatInt .Config.Terrain}} × {{formatInt .Config.Pack}} = {{formatInt .TotalLemmings}}</td></tr>
      <tr><td>limit</td><td class="num">{{.Config.Limit}}</td></tr>
      <tr><td>until · ramp</td><td class="num">{{.Config.Until}} · {{.Config.Ramp}} ({{.Config.RampShape}})</td></tr>
      <tr><td>think time</td><td class="num">{{.Config.ThinkMin}} – {{.Config.ThinkMax}}</td></tr>
      <tr><td>navigation</td><td class="num">{{if .Plan}}plan{{with planNames .Plan}} “{{.}}”{{end}}{{else}}{{.Config.Navigation}}{{end}}</td></tr>
      {{if .Plan}}<tr><td>rogue rate</td><td class="num">{{pct .Plan.RogueRate}}</td></tr>{{end}}
      <tr><td>assets</td><td class="num">{{if .Config.Assets}}enabled ({{.Config.AssetsPerPage}}/page){{else}}disabled{{end}}</td></tr>
      <tr><td>forensics capture</td><td class="num">{{.Forensics.Stats.Mode}}{{if .Forensics.Stats.Browser}} ({{.Forensics.Stats.Browser}}){{end}}</td></tr>
      <tr><td>browser scouts</td><td class="num">{{.Config.Scouts}}</td></tr>
    </table></div>
  </div>
  <div>
    <h2 class="section">Evidence</h2>
    <div class="card"><table>
      <tr><td>schema version</td><td class="num">{{.SchemaVersion}}</td></tr>
      <tr><td>percentiles</td><td>{{.PercentileMethod}}</td></tr>
      <tr><td>lemmings started</td><td class="num">{{formatInt .LemmingsStarted}}</td></tr>
      <tr><td>lemmings completed</td><td class="num">{{formatInt .LemmingsCompleted}}</td></tr>
      <tr><td>lemmings never started</td><td class="num">{{formatInt .LemmingsUnborn}}</td></tr>
      <tr><td>checksum changes</td><td class="num">{{formatInt .ChecksumChanges}}{{if not .Config.StrictChecksum}} <span class="muted">(informational)</span>{{end}}</td></tr>
      <tr><td>forensics deduped / dropped</td><td class="num">{{formatInt .Forensics.Stats.Deduplicated}} deduped · {{formatInt .Forensics.Stats.DroppedQueue}} queue · {{formatInt .Forensics.Stats.DroppedCap}} cap</td></tr>
      <tr><td>life records dropped</td><td class="num{{if .DroppedLogs}} warn-text{{end}}">{{formatInt .DroppedLogs}}</td></tr>
      {{if .TraceFile}}<tr><td>trace file</td><td><code>{{.TraceFile}}</code><br>{{formatInt .TraceWritten}} written{{if .TraceDropped}}, <span class="warn-text">{{formatInt .TraceDropped}} dropped</span>{{end}}{{if .TraceError}}<br><span class="fail-text">{{.TraceError}}</span>{{end}}</td></tr>{{end}}
      {{range .ExitReasons}}<tr><td>left by {{.Label}}</td><td class="num">{{formatInt .Count}}</td></tr>{{end}}
    </table></div>
  </div>
</div>

<footer>generated by lemmings v{{.Version}} · {{.GeneratedAt.Format "2006-01-02 15:04:05 MST"}}</footer>
</main>
</body>
</html>