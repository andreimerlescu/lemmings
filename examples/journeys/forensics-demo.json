{
  "name": "forensics-demo",
  "steps": [
    {
      "name": "arrive",
      "path": "/",
      "expect": { "status": [200], "title_contains": "Neon Arcade", "contains": ["Insert coin"] }
    },
    {
      "name": "pick-game",
      "path": "/games/outrun",
      "expect": { "status": [200], "title_contains": "Outrun Horizon" }
    },
    {
      "name": "tokens-page",
      "path": "/tokens",
      "expect": { "status": [200], "contains": ["10 tokens"], "not_contains": ["Something went wrong"] }
    },
    {
      "name": "token-api",
      "path": "/api/tokens",
      "expect": { "status": [200], "content_type": "application/json" }
    },
    {
      "name": "crt-diagnostics",
      "path": "/arcade-glitch",
      "expect": { "status": [200], "contains": ["Arcade Cabinet Glitch"] }
    }
  ]
}
